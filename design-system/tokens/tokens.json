{
  "$meta": {
    "name": "The Appliance Connection — Design Tokens",
    "sourceOfTruth": true,
    "runtimeMirror": "tokens.css",
    "note": "Tweakable placeholder defaults encoding the agreed direction (monochrome foundation + intentional colour punctuation; warm editorial; Benguiat display + system body). Components consume the SEMANTIC roles only. Primitives hold raw values; semantic roles reference a primitive by dotted path.",
    "intent": {
      "monochromeBase": "Neutrals inherited from the black/white cube trucks — carry brand recognition.",
      "colourAsPunctuation": "Blue + warm brass used sparingly (CTAs, highlights, section accents).",
      "rule": "Chrome = monochrome + accents; photography = full colour."
    }
  },

  "color": {
    "primitive": {
      "neutral": {
        "0": "#ffffff",
        "50": "#f8f5f0",
        "100": "#efe9e0",
        "200": "#e7e0d5",
        "300": "#dad3c7",
        "400": "#c4bbac",
        "500": "#9a9082",
        "600": "#6b6357",
        "700": "#4a443c",
        "800": "#2c2822",
        "900": "#1d1a16"
      },
      "blue": {
        "100": "#e9f0f5",
        "300": "#9cc0d8",
        "500": "#2a79a8",
        "600": "#1d5b84",
        "800": "#123f5c"
      },
      "brass": {
        "100": "#f4ecdd",
        "300": "#d8bc8c",
        "500": "#b58a4b",
        "600": "#a67e3f",
        "700": "#94702f"
      },
      "support": {
        "green600": "#2f7a55",
        "red600": "#b3402f"
      }
    },
    "semantic": {
      "bg": "neutral.50",
      "bgAlt": "neutral.100",
      "bgSunken": "neutral.200",
      "surface": "neutral.0",
      "text": "neutral.900",
      "textSoft": "neutral.700",
      "textMuted": "neutral.600",
      "textOnBrand": "neutral.0",
      "border": "neutral.300",
      "borderStrong": "neutral.400",
      "brand": "blue.600",
      "brandDeep": "blue.800",
      "brandTint": "blue.100",
      "accent": "brass.500",
      "accentDeep": "brass.700",
      "accentTint": "brass.100",
      "inverseBg": "neutral.900",
      "inverseBgAlt": "neutral.800",
      "inverseText": "neutral.50",
      "inverseTextSoft": "neutral.400",
      "brandOnDark": "blue.300",
      "ctaBg": "brass.500",
      "ctaBgHover": "brass.600",
      "ctaText": "neutral.900",
      "link": "blue.600",
      "linkHover": "blue.800",
      "success": "support.green600",
      "error": "support.red600"
    },
    "contrastNotes": {
      "ctaBrassInkText": "≈5.6:1 (AA normal)",
      "ctaHoverBrass600InkText": "≈4.7:1 (AA normal)",
      "textMutedOnPaper": "≈4.75:1 (AA normal, minimum tier — prefer textSoft for long copy)"
    }
  },

  "typography": {
    "fontFamily": {
      "display": "\"ITC Benguiat\", \"Benguiat\", \"Iowan Old Style\", Georgia, \"Times New Roman\", serif",
      "body": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Oxygen, Ubuntu, Cantarell, \"Helvetica Neue\", Arial, sans-serif",
      "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
    },
    "fontFamilyNote": "Benguiat = display/headings/wordmark ONLY (matches the trucks); self-host + subset when licensed. Body/UI = system stack (zero-cost). Serif fallback keeps layout stable pre-license.",
    "fontSize": {
      "xs": "0.79rem",
      "sm": "0.889rem",
      "base": "1rem",
      "md": "1.125rem",
      "lg": "clamp(1.2rem, 1.10rem + 0.5vw, 1.44rem)",
      "xl": "clamp(1.5rem, 1.30rem + 1.0vw, 1.95rem)",
      "2xl": "clamp(1.95rem, 1.60rem + 1.8vw, 2.75rem)",
      "3xl": "clamp(2.6rem, 2.00rem + 3.0vw, 3.9rem)",
      "display": "clamp(3.2rem, 2.20rem + 5.0vw, 5.5rem)"
    },
    "lineHeight": {
      "none": 1,
      "tight": 1.08,
      "snug": 1.2,
      "normal": 1.6,
      "relaxed": 1.75
    },
    "fontWeight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700,
      "display": 400
    },
    "letterSpacing": {
      "tight": "-0.02em",
      "normal": "0",
      "wide": "0.08em"
    }
  },

  "space": {
    "3xs": "0.125rem",
    "2xs": "0.25rem",
    "xs": "0.5rem",
    "sm": "0.75rem",
    "md": "1rem",
    "lg": "1.5rem",
    "xl": "2rem",
    "2xl": "3rem",
    "3xl": "4rem",
    "4xl": "6rem",
    "5xl": "8rem"
  },

  "radius": {
    "none": "0",
    "sm": "2px",
    "md": "4px",
    "lg": "8px",
    "xl": "16px",
    "pill": "999px"
  },

  "shadow": {
    "sm": "0 1px 2px rgba(29,26,22,0.06), 0 1px 1px rgba(29,26,22,0.04)",
    "md": "0 6px 20px -6px rgba(29,26,22,0.14)",
    "lg": "0 20px 50px -12px rgba(29,26,22,0.22)"
  },

  "size": {
    "containerWide": "84rem",
    "containerMax": "75rem",
    "containerNarrow": "44rem",
    "gutter": "clamp(1rem, 0.5rem + 3vw, 2.5rem)",
    "measure": "66ch"
  },

  "motion": {
    "easeStandard": "cubic-bezier(0.2, 0, 0, 1)",
    "easeOut": "cubic-bezier(0, 0, 0.2, 1)",
    "durFast": "120ms",
    "dur": "200ms",
    "durSlow": "360ms"
  },

  "z": {
    "header": 100,
    "overlay": 200,
    "modal": 300
  }
}
