---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Request a Quote — The Appliance Connection">
  <section class="section">
    <div class="container" style="max-width: var(--container-narrow)">
      <p class="eyebrow">Contact</p>
      <h1>Request a quote</h1>
      <p>
        Call <a href="tel:19052596545">Durham 905·259·6545</a> or
        <a href="tel:17057420306">Peterborough 705·742·0306</a> — or send the details below and
        we’ll respond within 24 hours.
      </p>
      <p style="color: var(--color-text-muted); font-size: var(--text-sm)">
        The quote form (name · contact · service · region · optional photo) is a React island —
        coming next. This is a skeletal placeholder.
      </p>
    </div>
  </section>
</BaseLayout>
