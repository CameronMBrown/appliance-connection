---
// ac/hero → the video Hero, rendered as a React island.
// Why an island: the arched wordmark measures its own text after the webfont
// loads, and the video logic (pick a rendition for this screen, honour
// prefers-reduced-motion / Data Saver, pause control) needs JS.
// client:load because it's above the fold. The poster <img> is server-rendered,
// so the LCP element paints from the HTML without waiting for hydration.
// Forked from the design system's Hero: see islands/Hero.tsx.
import { Hero } from '../islands/Hero';
import type { BlockContext, EditorBlock, HeroAttrs } from '../../lib/blocks/types';

interface Props extends HeroAttrs {
  innerBlocks?: EditorBlock[];
  context?: BlockContext;
}

const { showPhones = false, context = {}, innerBlocks: _inner, ...attrs } = Astro.props;
const phones = showPhones
  ? (context.phones ?? []).map((p) => ({ label: `Phone ${p.name}`, phone: p.phone, tel: p.tel }))
  : [];
---

<Hero client:load {...attrs} phones={phones} />
