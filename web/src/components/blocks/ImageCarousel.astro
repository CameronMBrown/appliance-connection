---
// ac/image-carousel — an endless, slow-drifting mosaic of photos on the services page.
//
// The tiles are FIXED and irregular (tall, wide, square, narrow rectangles that
// interlock on an 8-column x 4-row grid); the photos are not. Each photo is cropped
// to its tile with object-fit: cover, around a focal point chosen in the editor, so
// the mix of portrait and landscape source photos never changes the layout. That is
// the design decision: the editor's job is "put this photo in this slot and keep the
// subject in frame", not "work out how big this photo will render".
//
// Two cluster layouts (A = 7 tiles, B = 8 tiles) alternate; one A+B pair is a "set"
// of 15 tiles. Photos fill the tiles in order; with fewer photos than tiles they wrap.
//
// The loop is a CSS animation on a track holding the whole sequence twice (or more,
// see `repeats`); it moves left by exactly half the track, so the second half lands
// where the first began and the seam never shows. Copies after the first are hidden
// from assistive tech and have empty alt text. A pause button is the WCAG 2.2.2
// control; hovering the strip also pauses it. With reduced motion nothing moves and
// the strip becomes a plain horizontally scrollable row (one copy only).
import type { BlockContext, EditorBlock, ImageCarouselAttrs } from '../../lib/blocks/types';

interface Props extends ImageCarouselAttrs {
  innerBlocks?: EditorBlock[];
  context?: BlockContext;
}

const { heading = 'Recent appliance installations', images: allImages = [], divider = false } = Astro.props;

/** A tile: column / row start (1-based) and column / row span on the 8 x 4 cluster grid. */
interface Tile {
  c: number;
  r: number;
  w: number;
  h: number;
}

const CLUSTER_A: Tile[] = [
  { c: 1, r: 1, w: 2, h: 4 }, // tall
  { c: 3, r: 1, w: 3, h: 2 }, // wide
  { c: 3, r: 3, w: 2, h: 2 }, // square
  { c: 5, r: 3, w: 1, h: 2 }, // narrow
  { c: 6, r: 1, w: 3, h: 2 }, // wide
  { c: 6, r: 3, w: 1, h: 2 }, // narrow
  { c: 7, r: 3, w: 2, h: 2 }, // square
];
const CLUSTER_B: Tile[] = [
  { c: 1, r: 1, w: 3, h: 2 }, // wide
  { c: 1, r: 3, w: 1, h: 2 }, // narrow
  { c: 2, r: 3, w: 2, h: 2 }, // square
  { c: 4, r: 1, w: 2, h: 4 }, // tall
  { c: 6, r: 1, w: 2, h: 2 }, // square
  { c: 8, r: 1, w: 1, h: 2 }, // narrow
  { c: 6, r: 3, w: 2, h: 2 }, // square
  { c: 8, r: 3, w: 1, h: 2 }, // narrow
];
const SET: Tile[][] = [CLUSTER_A, CLUSTER_B];
const TILES_PER_SET = CLUSTER_A.length + CLUSTER_B.length; // 15
const MAX_SETS = 3;
const COLS = 8;

const images = allImages.filter((img) => img?.url).slice(0, TILES_PER_SET * MAX_SETS);
const sets = Math.max(1, Math.ceil(images.length / TILES_PER_SET));

// One sequence = `sets` sets of [A, B]. Each cluster knows which photos it holds.
let next = 0;
const sequence = Array.from({ length: sets }, () =>
  SET.map((tiles) =>
    tiles.map((tile) => {
      const image = images[next++ % images.length];
      return { tile, image };
    }),
  ),
).flat();

// Estimated width of one sequence at the widest unit (7rem = 112px + 8px gap), used only to
// size the repeat count and the loop duration, not for layout.
const UNIT_MAX = 112;
const GAP = 8;
const sequenceWidth = sequence.length * COLS * (UNIT_MAX + GAP);
const WIDEST_SCREEN = 2600;
const repeats = Math.max(1, Math.ceil(WIDEST_SCREEN / sequenceWidth));
const SPEED = 40; // px per second: a slow drift
const duration = Math.round((sequenceWidth * repeats) / SPEED);
const copies = Array.from({ length: repeats * 2 }, (_, i) => i);

/** `sizes` for a tile spanning `w` columns: about w * unit, unit = 4.5rem on phones, up to 7rem. */
const sizesFor = (w: number) => `(max-width: 700px) ${Math.round(w * 4.5 * 10) / 10}rem, ${w * 7}rem`;
---

{
  images.length > 0 && (
    <section class:list={['ic', { 'has-divider': divider }]} aria-labelledby="ic-heading">
      <h2 id="ic-heading" class="ic__sr">
        {heading}
      </h2>
      <div class="ic__view">
        <div class="ic__track" style={`--ic-duration: ${duration}s`}>
          {copies.map((copy) => (
            <div class="ic__seq" aria-hidden={copy > 0 ? 'true' : undefined}>
              {sequence.map((cluster) => (
                <div class="ic__cluster">
                  {cluster.map(({ tile, image }) => (
                    <figure
                      class="ic__tile"
                      style={`grid-column: ${tile.c} / span ${tile.w}; grid-row: ${tile.r} / span ${tile.h}; --fx: ${image.focalX ?? 50}%; --fy: ${image.focalY ?? 50}%`}
                    >
                      <img
                        src={image.url}
                        srcset={image.srcset || undefined}
                        sizes={sizesFor(tile.w)}
                        width={image.width || undefined}
                        height={image.height || undefined}
                        alt={copy === 0 ? image.alt : ''}
                        loading="lazy"
                        decoding="async"
                        draggable="false"
                      />
                    </figure>
                  ))}
                </div>
              ))}
            </div>
          ))}
        </div>
      </div>
      <div class="ic__bar">
        <button type="button" class="ic__pause" aria-label="Pause carousel">
          <svg class="ic__ico ic__ico--pause" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
            <path d="M4 3h3v10H4zM9 3h3v10H9z" fill="currentColor" />
          </svg>
          <svg class="ic__ico ic__ico--play" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
            <path d="M5 3l8 5-8 5z" fill="currentColor" />
          </svg>
        </button>
      </div>
    </section>
  )
}

<script>
  document.querySelectorAll<HTMLElement>('.ic').forEach((section) => {
    const btn = section.querySelector<HTMLButtonElement>('.ic__pause');
    if (!btn) return;
    btn.addEventListener('click', () => {
      const paused = section.classList.toggle('is-paused');
      btn.toggleAttribute('data-idle', paused);
      btn.setAttribute('aria-label', paused ? 'Play carousel' : 'Pause carousel');
    });
  });
</script>

<style>
  .ic {
    --ic-unit: clamp(4.5rem, 9vw, 7rem);
    --ic-gap: var(--grid-size);
    position: relative;
    padding-block: clamp(2rem, 5vw, 3.5rem) var(--space-md);
    /* No ground of its own: the tiles sit on the body's graph paper. */
    overflow: hidden;
  }
  /* Visually hidden heading: read by search engines and screen readers only. */
  .ic__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    margin: 0;
  }
  .ic__view {
    overflow: hidden;
  }
  .ic__track {
    display: flex;
    width: max-content;
  }
  .ic__seq {
    display: flex;
    flex: none;
  }
  /* 8 columns x 4 rows of square cells; a tile spans whole cells, so every tile is a
     plain rectangle and the gaps line up on the 8px graph. The right margin is the
     gap to the next cluster, so a sequence is exactly one loop wide. */
  .ic__cluster {
    flex: none;
    display: grid;
    grid-template-columns: repeat(8, var(--ic-unit));
    grid-template-rows: repeat(4, var(--ic-unit));
    gap: var(--ic-gap);
    margin-right: var(--ic-gap);
  }
  .ic__tile {
    margin: 0;
    min-width: 0;
    min-height: 0;
    border: 1px solid var(--color-border-strong);
    background: var(--color-bg-sunken);
    overflow: hidden;
  }
  .ic__tile img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--fx, 50%) var(--fy, 50%);
    user-select: none;
  }

  .ic__bar {
    display: flex;
    justify-content: flex-end;
    max-width: var(--container-max);
    margin-inline: auto;
    padding: var(--space-sm) var(--gutter) 0;
  }
  .ic__pause {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 1px solid var(--color-border-strong);
    background: var(--color-surface);
    color: var(--color-text);
    cursor: pointer;
  }
  .ic__pause:hover {
    background: var(--color-bg-alt);
  }
  .ic__ico--play,
  .ic__pause[data-idle] .ic__ico--pause {
    display: none;
  }
  .ic__pause[data-idle] .ic__ico--play {
    display: block;
  }

  @media (prefers-reduced-motion: no-preference) {
    .ic__track {
      animation: ic-drift var(--ic-duration) linear infinite;
    }
    .ic__view:hover .ic__track,
    .ic.is-paused .ic__track {
      animation-play-state: paused;
    }
  }
  @keyframes ic-drift {
    to {
      transform: translateX(-50%);
    }
  }

  /* Reduced motion: nothing moves. One copy, scrollable by hand. */
  @media (prefers-reduced-motion: reduce) {
    .ic__view {
      overflow-x: auto;
      padding-inline: var(--gutter);
    }
    .ic__seq:not(:first-child) {
      display: none;
    }
    .ic__bar {
      display: none;
    }
  }
</style>
