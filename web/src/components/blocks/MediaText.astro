---
// ac/media-text — ruled heading + rich-text body beside an illustration
// ("Local crew, local calls" on the Location template).
// `background: 'dark'` (Section settings) gives an ink band with white text and
// frames the illustration in a white box so line art stays legible. Styled here
// with the inverse tokens, not the `.on-dark` scope.
import type { BlockContext, EditorBlock, MediaTextAttrs } from '../../lib/blocks/types';

interface Props extends MediaTextAttrs {
  innerBlocks?: EditorBlock[];
  context?: BlockContext;
}

const {
  heading,
  paragraphs = [],
  imageUrl,
  imageAlt = '',
  imagePosition = 'right',
  mobileImagePosition = 'below',
  background = 'paper',
} = Astro.props;
// Sections left empty in the locked Location template don't render.
const hasContent = Boolean(heading) || paragraphs.length > 0;
---

{
  hasContent && (
    <section
      class:list={[
        'band',
        { 'band--alt': background === 'alt', 'mt--dark': background === 'dark' },
      ]}
    >
      <div
        class:list={[
          'container mt',
          { 'mt--flip': imagePosition === 'left', 'mt--above': mobileImagePosition === 'above' },
        ]}
      >
        <div class="mt__copy">
          {heading && <h2 class="mt__h">{heading}</h2>}
          {paragraphs.length > 0 && (
            <div class="mt__body">
              {paragraphs.map((p) => (
                <p set:html={p} />
              ))}
            </div>
          )}
        </div>
        {imageUrl && (
          <div class="mt__art">
            <img src={imageUrl} alt={imageAlt} width="720" height="720" loading="lazy" />
          </div>
        )}
      </div>
    </section>
  )
}

<style>
  .mt {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }
  /* Illustration on the left (desktop only; the stacked rules below override it). */
  .mt--flip {
    flex-direction: row-reverse;
  }
  .mt__copy {
    flex: 1 1 24rem;
    min-width: 0;
  }
  .mt__h {
    font-size: var(--text-2xl);
    margin: 0 0 var(--space-lg);
    padding-bottom: var(--space-md);
    border-bottom: 1px solid var(--color-border-strong);
  }
  .mt__body :global(p) {
    color: var(--color-text-soft);
    font-size: var(--text-md);
  }
  .mt__body :global(p:last-child) {
    margin-bottom: 0;
  }
  .mt__art {
    flex: 0 1 22rem;
    display: flex;
    justify-content: center;
    min-width: 0;
  }
  /* Dark band: ink ground, white text, white box behind the art. */
  .mt--dark {
    background-color: var(--color-inverse-bg);
    color: var(--color-inverse-text);
    border-top-color: var(--color-inverse-text);
  }
  .mt--dark .mt__h {
    color: var(--color-inverse-text);
    border-bottom-color: var(--color-inverse-text);
  }
  .mt--dark .mt__body :global(p) {
    color: var(--color-inverse-text-soft);
  }
  .mt--dark .mt__body :global(a) {
    color: var(--color-brand-on-dark);
  }
  .mt--dark .mt__art {
    align-self: center;
    background: var(--color-inverse-bg-alt);
    border: 1px solid var(--color-inverse-text);
    box-shadow: var(--shadow-md);
    padding: clamp(1rem, 3vw, 2rem);
  }
  .mt__art img {
    width: 100%;
    max-width: 20rem;
    height: auto;
    object-fit: contain;
  }
  /* Stacked (tablet and below): single column, copy first unless `--above`.
     Art is centred either way; the desktop `--flip` no longer applies. */
  @media (max-width: 900px) {
    .mt,
    .mt--flip {
      flex-direction: column;
      align-items: stretch;
    }
    /* Desktop `flex-basis: 24rem` is a width in a row but a height in a column. */
    .mt__copy {
      flex: 0 0 auto;
    }
    .mt__art {
      flex: 0 0 auto;
      width: 100%;
      max-width: 22rem;
      align-self: center;
    }
    .mt--above .mt__art {
      order: -1;
    }
  }
</style>
