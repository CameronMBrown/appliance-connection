---
// ac/town-carousel — the service-area coverage strip on region pages: a ruled
// box with a small label at the left and a slow, endlessly looping line of town
// names, each separated by the AC truck mark. Informational only (towns don't
// link yet). Replaces the old town grid.
//
// The loop is a CSS animation on a track holding the list twice; it moves left by
// exactly one list's width, so the second copy lands where the first began and
// the seam never shows. Each copy is repeated enough to be wider than the widest
// screen, so the strip is never short of towns. Copies after the first are hidden
// from assistive tech. With reduced motion the strip stops and the towns wrap
// into a plain list.
import type { BlockContext, EditorBlock, TownCarouselAttrs } from '../../lib/blocks/types';
import { truckPath } from '../trust-art/truck-path';

interface Props extends TownCarouselAttrs {
  innerBlocks?: EditorBlock[];
  context?: BlockContext;
}

const { heading = 'Towns we cover', towns = [] } = Astro.props;
const names = towns.map((t) => (typeof t === 'string' ? t : t.name)).filter(Boolean);

// Estimated width of one pass of the list (name + gaps + mark), used only to
// size the repeat count and the loop duration, not for layout.
const PX_PER_CHAR = 11;
const ITEM_PAD = 20 + 2 * 24; // mark + space either side
const listWidth = names.reduce((sum, n) => sum + n.length * PX_PER_CHAR + ITEM_PAD, 0);
const WIDEST_SCREEN = 2600;
const repeats = Math.max(1, Math.ceil(WIDEST_SCREEN / Math.max(listWidth, 1)));
const SPEED = 40; // px per second: a slow drift
const duration = Math.round((listWidth * repeats) / SPEED);
const copies = Array.from({ length: repeats * 2 }, (_, i) => i);
---

{
  names.length > 0 && (
    <section class="tc" aria-labelledby="tc-heading">
      <svg class="tc__defs" width="0" height="0" aria-hidden="true" focusable="false">
        <symbol id="ac-truck" viewBox="0 0 478 451">
          <path fill-rule="evenodd" d={truckPath} />
        </symbol>
      </svg>
      <div class="tc__in">
        <div class="tc__box">
          <h2 id="tc-heading" class="tc__label">
            {heading}
          </h2>
          <div class="tc__view">
            <div class="tc__track" style={`--tc-duration: ${duration}s`}>
              {copies.map((i) => (
                <ul class="tc__list" aria-hidden={i > 0 ? 'true' : undefined} role={i > 0 ? 'presentation' : undefined}>
                  {names.map((name) => (
                    <li class="tc__item">
                      <span class="tc__name">{name}</span>
                      <svg class="tc__mark" width="20" height="19" viewBox="0 0 478 451" aria-hidden="true" focusable="false">
                        <use href="#ac-truck" />
                      </svg>
                    </li>
                  ))}
                </ul>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}

<style>
  .tc {
    padding-block: clamp(2rem, 5vw, 3.5rem);
  }
  .tc__defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }
  .tc__in {
    max-width: var(--container-wide);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  /* Ruled box: label cell | strip. Phones stack the label over the strip. */
  .tc__box {
    display: grid;
    grid-template-columns: 1fr;
    background: var(--color-surface);
    border: 1px solid var(--color-border-strong);
  }
  .tc__label {
    margin: 0;
    padding: var(--space-md) var(--space-lg);
    border-bottom: 1px solid var(--color-border-strong);
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
    text-wrap: balance;
  }
  @media (min-width: 40rem) {
    .tc__box {
      grid-template-columns: auto minmax(0, 1fr);
    }
    .tc__label {
      display: flex;
      align-items: center;
      max-width: 11rem;
      padding: var(--space-lg);
      border-bottom: 0;
      border-right: 1px solid var(--color-border-strong);
    }
  }

  /* The window the towns drift through; its ends fade so names slide in and out
     rather than being cut off. */
  .tc__view {
    display: flex;
    align-items: center; /* the label cell sets the box height; centre the towns in it */
    min-width: 0;
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent, #000 5%, #000 95%, transparent);
  }
  .tc__track {
    display: flex;
    flex: none;
    width: max-content;
  }
  .tc__list {
    display: flex;
    flex: none;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tc__item {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-block: var(--space-lg);
    padding-right: 1.5rem;
    white-space: nowrap;
  }
  .tc__name {
    font-family: var(--font-body);
    font-weight: var(--weight-semibold);
    font-size: var(--text-md);
    line-height: 1;
    color: var(--color-text);
  }
  .tc__mark {
    flex: none;
    fill: var(--color-text);
  }

  /* One slow pass of the list per cycle; paused while the pointer is over it. */
  @media (prefers-reduced-motion: no-preference) {
    .tc__track {
      animation: tc-drift var(--tc-duration, 60s) linear infinite;
    }
    .tc__view:hover .tc__track {
      animation-play-state: paused;
    }
  }
  @keyframes tc-drift {
    to {
      transform: translateX(-50%);
    }
  }

  /* Reduced motion: no movement. One copy of the list, wrapped, left-aligned. */
  @media (prefers-reduced-motion: reduce) {
    .tc__view {
      mask-image: none;
    }
    .tc__track {
      width: auto;
    }
    .tc__list:not(:first-child) {
      display: none;
    }
    .tc__list {
      flex-wrap: wrap;
      padding-inline: var(--space-lg);
    }
    .tc__item {
      padding-block: var(--space-md);
    }
  }
</style>
