---
// ac/partners — "Our Selling Partners": one ruled cell per retail partner with
// logo tile, contact table (phone / email / address) and a greyscale map with a
// Directions tag. The light "trusted by retail partners" nod (decision 1).
import type { BlockContext, EditorBlock, PartnersAttrs } from '../../lib/blocks/types';

interface Props extends PartnersAttrs {
  innerBlocks?: EditorBlock[];
  context?: BlockContext;
}

const { heading = 'Our Selling Partners', partners = [], background = 'alt' } = Astro.props;

// One partner has room for a map; two or more get a compact card whose address
// opens Google Maps in a new tab instead.
const single = partners.length === 1;
const mapsUrl = (address: string[]) =>
  `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address.join(', '))}`;
---

{
  partners.length > 0 && (
    <section class:list={['band', { 'band--alt': background === 'alt' }]}>
      <div class="container">
        <h2 class="pt__h">{heading}</h2>
        <div class:list={['pt__grid', { 'pt__grid--single': single }]}>
          {partners.map((p) => (
            <div class="pt__cell">
              <a class="pt__logo" href={p.url} target="_blank" rel="noopener">
                {p.logoUrl ? <img src={p.logoUrl} alt={p.name} loading="lazy" /> : <span>{p.name}</span>}
              </a>
              <div class="pt__body">
                {p.area && <p class="pt__area">{p.area}</p>}
                <div class="pt__table">
                  {p.phone && (
                    <>
                      <span class="pt__k">Phone</span>
                      <a class="pt__v pt__v--phone" href={`tel:${p.tel}`}>
                        {p.phone}
                      </a>
                    </>
                  )}
                  {p.email && (
                    <>
                      <span class="pt__k">Email</span>
                      <a class="pt__v pt__v--email" href={`mailto:${p.email}`}>
                        {p.email}
                      </a>
                    </>
                  )}
                  {p.address && (
                    <>
                      <span class="pt__k">Address</span>
                      {(() => {
                        const lines = p.address.map((line, i) => (
                          <>
                            {i > 0 && <br />}
                            {line}
                          </>
                        ));
                        return single ? (
                          <span class="pt__v pt__v--addr">{lines}</span>
                        ) : (
                          <a
                            class="pt__v pt__v--addr pt__v--link"
                            href={mapsUrl(p.address)}
                            target="_blank"
                            rel="noopener"
                            title="Open in Google Maps"
                          >
                            {lines}
                          </a>
                        );
                      })()}
                    </>
                  )}
                </div>
              </div>
              {single && p.mapEmbedUrl && (
                <div class="pt__map">
                  <iframe src={p.mapEmbedUrl} title={`Map — ${p.address?.join(', ') ?? p.name}`} loading="lazy" />
                  {p.directionsUrl && (
                    <a class="pt__dir" href={p.directionsUrl} target="_blank" rel="noopener">
                      Directions
                    </a>
                  )}
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .band {
    padding-block: clamp(3rem, 7vw, 5rem);
  }
  .pt__h {
    font-size: var(--text-xl);
    margin: 0 0 var(--space-md);
    padding-bottom: var(--space-md);
    border-bottom: 1px solid var(--color-border-strong);
  }
  .pt__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    background: var(--color-surface);
    border-top: 1px solid var(--color-border-strong);
    border-left: 1px solid var(--color-border-strong);
    /* Cells rule their own right/bottom edges with real borders. (An inset shadow
       is painted under the cell's children, so the logo tile's background hid it.)
       The frame's inset rule closes the right/bottom edge where a short last row
       leaves space. */
    box-shadow:
      inset -1px -1px 0 var(--color-border-strong),
      var(--shadow-md);
    margin-top: var(--space-xl);
  }
  .pt__cell {
    background: var(--color-surface);
    border-right: 1px solid var(--color-border-strong);
    border-bottom: 1px solid var(--color-border-strong);
    display: flex;
    flex-direction: column;
  }
  /* Neighbours in a row share their logo / body / map tracks (subgrid), so the
     logo tiles, contact tables and maps line up whatever each partner's content
     runs to. The flex column above (map pinned to the bottom) is the fallback. */
  @supports (grid-template-rows: subgrid) {
    .pt__cell {
      display: grid;
      grid-row: span 3;
      grid-template-rows: subgrid;
      row-gap: 0;
    }
  }
  .pt__body {
    align-content: start;
  }
  .pt__logo {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 9rem;
    padding: var(--space-xl);
    border-bottom: 1px solid var(--color-border-strong);
    background-color: var(--color-bg);
    background-image: var(--grid-image);
    background-size: var(--grid-size) var(--grid-size);
    text-decoration: none;
    transition: background-color var(--dur) var(--ease-standard);
  }
  .pt__logo:hover {
    background-color: var(--color-accent-tint);
  }
  .pt__logo img {
    width: 100%;
    max-width: 17rem;
    height: auto;
  }
  .pt__body {
    padding: var(--space-lg) var(--space-xl);
  }
  .pt__area {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    font-weight: 600;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-md);
  }
  /* Stacked cards (two or more partners) centre the "Serving …" label. */
  .pt__grid:not(.pt__grid--single) .pt__area {
    text-align: center;
  }
  .pt__table {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    font-size: var(--text-sm);
    border-top: 1px solid var(--color-border);
  }
  .pt__k,
  .pt__v {
    padding: var(--space-sm) 0;
    border-bottom: 1px solid var(--color-border);
  }
  .pt__k:nth-last-child(2),
  .pt__v:last-child {
    border-bottom: 0;
  }
  .pt__k {
    color: var(--color-text-muted);
  }
  .pt__v--phone {
    color: var(--color-text);
    text-decoration: none;
    font-family: var(--font-display);
    font-size: var(--text-md);
    letter-spacing: var(--tracking-tight);
  }
  .pt__v--phone:hover {
    color: var(--link);
  }
  .pt__v--email {
    color: var(--link);
    text-decoration: none;
    word-break: break-word;
  }
  .pt__v--email:hover {
    color: var(--link-hover);
  }
  .pt__v--addr {
    color: var(--color-text-soft);
  }
  /* Address link in the multi-partner cards: same colours as the email link. */
  .pt__v--link {
    color: var(--link);
    text-decoration: none;
  }
  .pt__v--link:hover {
    color: var(--link-hover);
  }
  .pt__map {
    margin-top: auto;
    border-top: 1px solid var(--color-border-strong);
    position: relative;
  }
  .pt__map iframe {
    width: 100%;
    height: 170px;
    border: 0;
    display: block;
    filter: grayscale(1) contrast(1.05);
  }
  .pt__dir {
    position: absolute;
    right: var(--space-sm);
    bottom: var(--space-sm);
    background: var(--color-surface);
    border: 1px solid var(--color-border-strong);
    box-shadow: var(--shadow-sm);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
    padding: 0.4em 0.7em;
  }
  .pt__dir:hover {
    background: var(--cta-bg);
    color: var(--cta-text);
  }

  /* One partner: a full-width cell would stretch a 20rem card across the page,
     so lay logo | details | map side by side instead. Stacks below 56rem. */
  .pt__grid--single {
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 56rem) {
    .pt__grid--single .pt__cell {
      display: grid;
      grid-row: auto;
      grid-template-rows: none;
      grid-auto-flow: column;
      grid-auto-columns: minmax(0, 1fr);
    }
    .pt__grid--single .pt__logo {
      border-bottom: 0;
      border-right: 1px solid var(--color-border-strong);
    }
    .pt__grid--single .pt__body {
      padding: var(--space-xl);
      align-self: center;
    }
    .pt__grid--single .pt__map {
      margin-top: 0;
      border-top: 0;
      border-left: 1px solid var(--color-border-strong);
      min-height: 16rem;
    }
    .pt__grid--single .pt__map iframe {
      position: absolute;
      inset: 0;
      height: 100%;
    }
  }
</style>
