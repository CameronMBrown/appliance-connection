---
import type { EditorBlock, CtaBandAttrs } from '../../lib/blocks/types';

interface Props extends CtaBandAttrs {
  innerBlocks?: EditorBlock[];
}

const { heading, text, ctaLabel, ctaUrl, isDark = true } = Astro.props;
---

<section class:list={['cta-band section', { 'on-dark': isDark }]}>
  <div class="container cta-band__inner">
    {heading && <h2 class="cta-band__heading">{heading}</h2>}
    {text && <p class="cta-band__text">{text}</p>}
    {
      ctaLabel && (
        <a class="btn btn--primary" href={ctaUrl || '#'}>
          {ctaLabel}
        </a>
      )
    }
  </div>
</section>

<style>
  .cta-band {
    background: var(--color-bg);
  }
  .cta-band__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-md);
  }
  .cta-band__heading {
    font-size: var(--text-2xl);
    margin: 0;
  }
  .cta-band__text {
    color: var(--color-text-soft);
    margin: 0;
  }
</style>
