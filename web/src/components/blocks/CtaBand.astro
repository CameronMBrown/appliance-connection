---
// ac/cta-band — static port of design-system CtaBand: a boxed closing pitch
// with the wood corner tick, on the ruled band. `.on-dark` flips every semantic
// role (ink band, white rule), so the same markup serves both grounds.
// `showPhone` adds the page region's number as an outline button (Location template).
import type { BlockContext, CtaBandAttrs, EditorBlock } from '../../lib/blocks/types';

interface Props extends CtaBandAttrs {
  innerBlocks?: EditorBlock[];
  context?: BlockContext;
}

const { heading, text, ctaLabel, ctaUrl, isDark = true, showPhone = false, context = {}, divider = false } = Astro.props;
const phone = showPhone ? context.phones?.[0] : undefined;
---

<section class:list={['ac-cta-band', { 'grid-paper': isDark, 'on-dark': isDark, 'has-divider': divider }]}>
  <div class="container">
    <div class="ac-cta-band__box corner-tick">
      <div class="ac-cta-band__copy">
        {heading && <h2 class="ac-cta-band__heading">{heading}</h2>}
        {text && <p class="ac-cta-band__text">{text}</p>}
      </div>
      {
        (ctaLabel || phone) && (
          <div class="ac-cta-band__actions">
            {ctaLabel && (
              <a class="btn btn--primary" href={ctaUrl || '/contact/'}>
                {ctaLabel}
              </a>
            )}
            {phone && (
              <a class="btn btn--secondary" href={`tel:${phone.tel}`}>
                {phone.phone}
              </a>
            )}
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .ac-cta-band {
    color: var(--color-text);
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }
  /* Paper (the default) paints nothing: the body's graph paper shows. Dark paints
     the ink ground, with its own white ruling from .grid-paper. */
  .ac-cta-band.on-dark {
    background-color: var(--color-bg);
  }
  .ac-cta-band__box {
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border-strong);
    box-shadow: var(--shadow-lg);
    padding: clamp(1.75rem, 4vw, 3rem);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-lg) var(--space-2xl);
  }
  .ac-cta-band__copy {
    flex: 1 1 22rem;
    min-width: 0;
  }
  .ac-cta-band__heading {
    font-size: var(--text-2xl);
    margin: 0 0 var(--space-xs);
  }
  .ac-cta-band__text {
    color: var(--color-text-soft);
    margin: 0;
  }
  .ac-cta-band__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
  }
  .ac-cta-band__actions .btn {
    padding: 0.9em 1.7em;
  }
  .on-dark .btn--primary {
    border-color: var(--color-border-strong);
    box-shadow: var(--shadow-md);
  }
</style>
