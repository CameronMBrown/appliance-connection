---
// ac/page-header — the title band used by the Location and Contact templates:
// eyebrow, display headline, one line of intro, actions (Contact + the region's
// phone), and a Craig & Harley illustration on the right.
import type { BlockContext, EditorBlock, PageHeaderAttrs } from '../../lib/blocks/types';
import CtaButtons from '../CtaButtons.astro';

interface Props extends PageHeaderAttrs {
  innerBlocks?: EditorBlock[];
  context?: BlockContext;
}

const {
  eyebrow,
  heading,
  intro,
  illustrationUrl,
  illustrationAlt = '',
  primaryLabel,
  primaryUrl,
  showPhone = false,
  context = {},
} = Astro.props;

const phone = showPhone && context.region ? context.phones?.[0] : undefined;
---

<section class="ph">
  <div class="ph__in">
    <div class="ph__text">
      {eyebrow && <p class="ph__eyebrow">{eyebrow}</p>}
      {heading && <h1 class="ph__h">{heading}</h1>}
      {intro && <p class="ph__intro">{intro}</p>}
    </div>
    {
      (primaryLabel || phone) && (
        <div class:list={['ph__actions', illustrationUrl && 'ph__actions--over-art']}>
          <CtaButtons primaryLabel={primaryLabel} primaryUrl={primaryUrl} {phone} />
        </div>
      )
    }
    {
      illustrationUrl && (
        <div class="ph__art">
          <img src={illustrationUrl} alt={illustrationAlt} width="720" height="720" />
        </div>
      )
    }
  </div>
</section>

<style>
  .ph {
    background-image: var(--grid-image);
    background-size: var(--grid-size) var(--grid-size);
  }
  .ph__in {
    max-width: var(--container-max);
    margin-inline: auto;
    padding: clamp(2.5rem, 6vw, 4.5rem) var(--gutter) clamp(2rem, 4vw, 3rem);
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas: 'text art' 'actions actions';
    column-gap: clamp(1.5rem, 5vw, 4rem);
    align-items: center;
  }
  .ph__text {
    grid-area: text;
    min-width: 0;
  }
  .ph__eyebrow {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    font-weight: 600;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-md);
  }
  .ph__h {
    font-size: var(--text-3xl);
    line-height: var(--leading-tight);
    margin: 0 0 var(--space-lg);
    max-width: 18ch;
  }
  .ph__intro {
    color: var(--color-text-soft);
    font-size: var(--text-md);
    max-width: 54ch;
    margin: 0;
  }
  .ph__actions {
    grid-area: actions;
    align-self: start;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    align-items: center;
    margin-top: var(--space-xl);
  }
  .ph__art {
    grid-area: art;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    min-width: 0;
  }
  .ph__art img {
    height: clamp(11rem, 30vw, 22rem);
    width: auto;
    max-width: 100%;
    object-fit: contain;
  }

  /* Tablet and down: the illustration and the buttons share one grid cell under
     the copy. The art fills the cell (taller than the buttons need) and sits
     behind them; the buttons pin to the cell's bottom edge. */
  @media (max-width: 900px) {
    .ph__in {
      grid-template-columns: 1fr;
      grid-template-areas: 'text' 'stage';
      align-items: stretch;
      row-gap: var(--space-md);
    }
    .ph__intro {
      max-width: none;
    }
    .ph__art {
      grid-area: stage;
      position: relative;
      z-index: 0;
      justify-content: center;
    }
    .ph__art img {
      height: clamp(12.8rem, 50vw, 24rem);
      width: auto;
    }
    .ph__actions {
      grid-area: stage;
      align-self: end;
      position: relative;
      z-index: 1;
      margin-top: 0;
      padding-bottom: var(--space-lg);
      justify-content: center;
    }
    .ph__actions--over-art {
      --cta-shadow: var(--shadow-lg);
      --cta-shadow-hover: var(--shadow-lg);
    }
  }

  @media (max-width: 640px) {
    .ph__art {
      display: none;
    }
    .ph__actions {
      align-self: start;
      padding-bottom: 0;
      justify-content: center;
    }
    .ph__actions--over-art {
      --cta-shadow: var(--shadow-sm);
      --cta-shadow-hover: var(--shadow-md);
    }
  }
</style>
