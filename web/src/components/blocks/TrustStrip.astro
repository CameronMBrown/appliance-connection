---
// ac/trust-strip — the homepage's ruled credential row under the hero. Each
// cell gets a small square marker (wood / ink / outline, cycling). Data-driven:
// renders nothing without real items — we never fake trust.
import type { BlockContext, EditorBlock, TrustStripAttrs } from '../../lib/blocks/types';

interface Props extends TrustStripAttrs {
  innerBlocks?: EditorBlock[];
  context?: BlockContext;
}

const { items = [] } = Astro.props;
const markers = ['wood', 'ink', 'outline'];
---

{
  items.length > 0 && (
    <section class="ts">
      <div class="ts__in">
        <div class="ts__grid">
          {items.map((label, i) => (
            <p class="ts__cell">
              <span class={`ts__mark ts__mark--${markers[i % markers.length]}`} aria-hidden="true" />
              {label}
            </p>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .ts {
    border-bottom: 1px solid var(--color-border-strong);
  }
  .ts__in {
    max-width: var(--container-wide);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  .ts__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    background: var(--color-surface);
    border-left: 1px solid var(--color-border-strong);
    /* Last row's bottom rule sits on the section's own bottom rule. */
    margin-bottom: -1px;
  }
  .ts__cell {
    margin: 0;
    max-width: none;
    background: var(--color-surface);
    box-shadow:
      inset -1px -1px 0 var(--color-border-strong);
    padding: var(--space-md) var(--space-lg);
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .ts__mark {
    width: 10px;
    height: 10px;
    flex: none;
  }
  .ts__mark--wood {
    background: var(--color-accent);
  }
  .ts__mark--ink {
    background: var(--color-text);
  }
  .ts__mark--outline {
    border: 1px solid var(--color-text);
  }
</style>
