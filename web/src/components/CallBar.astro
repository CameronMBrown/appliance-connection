---
// Static port of design-system/components/feedback/CallBar.jsx, pinned to the
// bottom of the viewport on mobile only — the one persistent fixed element in
// the system (the header scrolls with the page). Always ink, whatever the page.
import { ALL_PHONES, type Phone } from '../lib/site';

interface Props {
  label?: string;
  numbers?: Phone[];
}

const { label = 'Call us', numbers = ALL_PHONES } = Astro.props;
// Short labels keep both numbers on one line at phone width.
const short = (name: string) => name.replace(' Region', '');
---

<div class="ac-callbar-dock">
  <div class="ac-callbar">
    <strong class="ac-callbar__label">{label}</strong>
    <div class="ac-nums">
      {
        numbers.map((n) => (
          <a href={`tel:${n.tel}`}>
            <span>{short(n.name)}</span>
            {n.phone}
          </a>
        ))
      }
    </div>
  </div>
</div>

<style>
  .ac-callbar-dock {
    display: none;
  }
  @media (max-width: 640px) {
    .ac-callbar-dock {
      display: block;
      position: fixed;
      inset: auto 0 0 0;
      z-index: var(--z-header);
    }
    /* Keep the footer's last row clear of the docked bar. */
    :global(body) {
      padding-bottom: 5.5rem;
    }
  }
  .ac-callbar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-lg);
    align-items: center;
    justify-content: space-between;
    background: var(--neutral-900);
    color: var(--neutral-0);
    border-top: 1px solid var(--neutral-0);
    box-shadow: var(--shadow-lg);
    padding: var(--space-sm) var(--gutter);
  }
  .ac-callbar__label {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    font-weight: var(--weight-semibold);
    color: var(--wood-300);
  }
  .ac-nums {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
  }
  .ac-nums a {
    display: flex;
    flex-direction: column;
    gap: 0.15em;
    padding-inline: var(--space-md);
    min-height: 44px;
    justify-content: center;
    color: var(--neutral-0);
    text-decoration: none;
    font-family: var(--font-display);
    font-size: var(--text-md);
  }
  .ac-nums a + a {
    border-left: 1px solid rgba(255, 255, 255, 0.28);
  }
  .ac-nums a:hover {
    color: var(--wood-300);
  }
  .ac-nums span {
    font-family: var(--font-body);
    color: var(--neutral-400);
    font-weight: var(--weight-regular);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }
</style>
