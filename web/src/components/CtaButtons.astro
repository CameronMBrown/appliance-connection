---
// The Contact button + region phone button pair shared by PageHeader and
// TownGrid. Renders the two links only; the parent owns the wrapper and layout.
// A parent can lift the buttons off an image by setting --cta-shadow (and
// --cta-shadow-hover) on the wrapper.
import type { Phone } from '../lib/site';

interface Props {
  primaryLabel?: string;
  primaryUrl?: string;
  phone?: Phone;
}

const { primaryLabel, primaryUrl, phone } = Astro.props;
const shortName = phone?.name.replace(' Region', '');
---

{
  primaryLabel && (
    <a class="btn btn--primary" href={primaryUrl || '/contact/'}>
      {primaryLabel}
    </a>
  )
}
{
  phone && (
    <a class="cta__phone" href={`tel:${phone.tel}`}>
      <span>Call {shortName}</span>
      <strong>{phone.phone}</strong>
    </a>
  )
}

<style>
  .btn {
    padding: 0.9em 1.7em;
    box-shadow: var(--cta-shadow, var(--shadow-sm));
  }
  .btn--primary:hover {
    box-shadow: var(--cta-shadow-hover, var(--shadow-md));
  }
  .cta__phone {
    display: inline-flex;
    flex-direction: column;
    gap: 0.1em;
    text-decoration: none;
    color: var(--color-text);
    border: 1px solid var(--color-border-strong);
    padding: 0.6em 1.4em;
    background: var(--color-surface);
    box-shadow: var(--cta-shadow, var(--shadow-sm));
  }
  .cta__phone:hover {
    background: var(--color-bg-alt);
    color: var(--color-text);
  }
  .cta__phone span {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    font-weight: 600;
    color: var(--color-text-muted);
  }
  .cta__phone strong {
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-size: var(--text-lg);
    letter-spacing: var(--tracking-tight);
  }
</style>
