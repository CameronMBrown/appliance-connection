<script is:inline>
  // Load-in: the dots pop up one after another, top of the map first, over about
  // a second and a half once the bento cell scrolls into view. Inline so data-intro
  // hides the dots (scale 0) before first paint, with no flash; without JS, or with
  // reduced motion, the map is simply there. Each dot gets its delay from its
  // height (--d); the CSS animation (.dots circle below) does the rest.
  (function () {
    var svg = document.currentScript.previousElementSibling;
    if (!svg || !svg.classList.contains('ontario')) return;
    if (!('IntersectionObserver' in window)) return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var SPREAD_MS = 1000; // top dot starts at 0, bottom dot at this
    var DOT_MS = 500; // each dot's pop; keep in step with the animation in CSS (1.5s in all)
    var dots = svg.querySelectorAll('.dots circle');
    var min = Infinity;
    var max = -Infinity;
    for (var i = 0; i < dots.length; i++) {
      var y = +dots[i].getAttribute('cy');
      if (y < min) min = y;
      if (y > max) max = y;
    }
    for (var j = 0; j < dots.length; j++) {
      var f = (+dots[j].getAttribute('cy') - min) / (max - min || 1);
      dots[j].style.setProperty('--d', Math.round(f * SPREAD_MS) + 'ms');
    }
    svg.setAttribute('data-intro', '');
    var io = new IntersectionObserver(
      function (entries) {
        if (!entries.some(function (e) { return e.isIntersecting; })) return;
        io.disconnect();
        svg.classList.add('is-in');
        // Pulses wait until the last dot has landed.
        setTimeout(function () {
          svg.setAttribute('data-intro-done', '');
        }, SPREAD_MS + DOT_MS + 50);
      },
      { threshold: 0.2, rootMargin: '0px 0px -8% 0px' }
    );
    io.observe(svg.closest('.trust__cell') || svg);
  })();
</script>

<style>
  .ontario {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .dots {
    fill: #b38a5b;
    fill: var(--cell-gold, var(--color-accent));
  }
  /* Hover (see the script below) sets a translate + scale on each nearby dot;
     the transition is what makes them glide rather than jump. */
  /* Pulse rings are added by the script, so they carry no scope attribute. */
  .ontario :global(.ontario-ring) {
    fill: none;
    stroke: var(--cell-gold, var(--color-accent));
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
    transform-box: fill-box;
    transform-origin: center;
    opacity: 0;
    pointer-events: none;
  }
  .dots circle {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.3, 1);
  }
  /* Load-in (data-intro / .is-in come from the inline script above). Uses the
     standalone `scale` property so it composes with the hover and pulse
     transforms instead of fighting them. The pop is springy: each dot grows to
     150% in the first 40% of its 500ms, faster than the 60% it takes to settle
     back to its real size. Until then it sits at scale 0 (via fill backwards,
     which also holds it there through its --d delay). */
  .ontario[data-intro]:not(.is-in) .dots circle {
    scale: 0;
  }
  .ontario.is-in .dots circle {
    animation: dot-in 500ms var(--d, 0ms) backwards;
  }
  @keyframes dot-in {
    0% {
      scale: 0;
      animation-timing-function: cubic-bezier(0.2, 0.8, 0.3, 1);
    }
    40% {
      scale: 1.5;
      animation-timing-function: ease-in-out;
    }
    100% {
      scale: 1;
    }
  }
</style>

<script>
  // Hover: the dot under the pointer swells and its neighbours are shoved away,
  // like a lens pressed into the grid. One field, not per-dot listeners: each
  // pointer move recomputes every dot's distance to the pointer (917 dots, trivial)
  // and sets a transform only on dots in range; CSS transitions do the easing.
  // Mouse and pen only (touch is for scrolling), and not at all under reduced motion.
  // Pointer events are listened for on the whole cell, not the svg: the cell's copy
  // sits on top of the lower part of the map, and would otherwise swallow the hover.
  const SWELL_RADIUS = 6.5; // svg units: dots closer than this grow (grid pitch is 4.35)
  const SWELL_MAX = 3.4; // extra scale at the pointer (r 1.35 → ~6)
  const PUSH_RADIUS = 20; // dots closer than this are displaced
  const PUSH_MAX = 6; // peak displacement, svg units
  // Passive pulse: every so often a few random dots swell and settle. It doesn't
  // start new pulses while the pointer is over the cell (the hover effect takes
  // over), and picks up again shortly after it leaves.
  const PULSE_EVERY = [700, 1800]; // ms between pulse bursts (random in range)
  const PULSE_DOTS = [1, 3]; // dots per burst
  const PULSE_MS = [1500, 2400]; // one pulse's length
  const PULSE_SCALE = [2.2, 3.0]; // peak size
  const PULSE_RESUME_MS = 800; // pause after the pointer leaves
  // Where pulses land: the client's work (and most of Ontario's people) is in the
  // south, so pulses there are common and the north and middle are rare. South is
  // everything at or below this y in the 226-unit-tall map (about 46°N, roughly
  // the southern edge of the Canadian Shield). Pulses in the rest of the province
  // happen a sixth as often as in the south, together, so ~1 pulse in 7.
  const SOUTH_FROM_Y = 150;
  const REST_VS_SOUTH = 1 / 6;
  const REST_SHARE = REST_VS_SOUTH / (1 + REST_VS_SOUTH);
  // Each pulse also sends out a thin ring that grows and fades fast, like a
  // flash of light. It starts as the dot nears its peak.
  const RING_SCALE = [7, 9]; // final size, as a multiple of the dot's radius
  const RING_MS = 1100;
  const RING_START = 0.3; // fraction of the dot's pulse before the ring is released
  const SVG_NS = 'http://www.w3.org/2000/svg';
  const rand = ([min, max]: number[]) => min + Math.random() * (max - min);

  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<SVGSVGElement>('svg.ontario').forEach((svg) => {
      const dots = Array.from(svg.querySelectorAll<SVGCircleElement>('.dots circle')).map((el) => ({
        el,
        x: Number(el.getAttribute('cx')),
        y: Number(el.getAttribute('cy')),
        active: false,
      }));
      let pending: PointerEvent | null = null;
      let hovering = false;
      let resumeAt = 0;
      let visible = false;
      const pulsing = new Set<SVGCircleElement>();
      const south = dots.filter((d) => d.y >= SOUTH_FROM_Y);
      const rest = dots.filter((d) => d.y < SOUTH_FROM_Y);
      const pickDot = () => {
        const pool = Math.random() < REST_SHARE ? rest : south;
        return pool[Math.floor(Math.random() * pool.length)];
      };
      // Rings live in their own group beneath the dots, so the dots stay on top.
      const rings = document.createElementNS(SVG_NS, 'g');
      svg.querySelector('.dots')?.before(rings);
      const ring = (d: (typeof dots)[number], delay: number) => {
        const el = document.createElementNS(SVG_NS, 'circle');
        el.setAttribute('class', 'ontario-ring');
        el.setAttribute('cx', String(d.x));
        el.setAttribute('cy', String(d.y));
        el.setAttribute('r', '1.35');
        rings.append(el);
        const grow = rand(RING_SCALE).toFixed(2);
        // Opacity is spent by 65% of the way, the ring keeps travelling a little
        // after it has gone, so it reads as a flash rather than a drawn circle.
        el.animate(
          [
            { transform: 'scale(1)', opacity: 1, offset: 0 },
            { opacity: 0.6, offset: 0.25 },
            { opacity: 0, offset: 0.65 },
            { transform: `scale(${grow})`, opacity: 0, offset: 1 },
          ],
          { duration: RING_MS, delay, easing: 'cubic-bezier(0.15, 0.6, 0.3, 1)' }
        ).finished.then(
          () => el.remove(),
          () => el.remove()
        );
      };

      // The pulse loop only runs while its cell is on screen and the tab is
      // showing: it halts (no timer at all) when either stops being true, and picks
      // up again, with a fresh random delay, when both are true again.
      let timer = 0;
      const schedule = () => {
        timer = window.setTimeout(pulse, rand(PULSE_EVERY));
      };
      const resume = () => {
        if (!timer && visible && !document.hidden) schedule();
      };
      const halt = () => {
        clearTimeout(timer);
        timer = 0;
      };

      const pulse = () => {
        timer = 0;
        const landed = !svg.hasAttribute('data-intro') || svg.hasAttribute('data-intro-done');
        const calm = landed && !hovering && performance.now() >= resumeAt;
        if (calm) {
          const n = Math.round(rand(PULSE_DOTS));
          for (let i = 0; i < n; i++) {
            const dot = pickDot();
            const el = dot.el;
            if (pulsing.has(el)) continue;
            pulsing.add(el);
            const peak = rand(PULSE_SCALE).toFixed(2);
            const duration = rand(PULSE_MS);
            ring(dot, duration * RING_START);
            el.animate(
              { transform: ['scale(1)', `scale(${peak})`, 'scale(1)'] },
              { duration, easing: 'ease-in-out' }
            ).finished.then(
              () => pulsing.delete(el),
              () => pulsing.delete(el)
            );
          }
        }
        resume();
      };

      const reset = () => {
        pending = null;
        hovering = false;
        resumeAt = performance.now() + PULSE_RESUME_MS;
        for (const d of dots) {
          if (d.active) {
            d.el.style.transform = '';
            d.active = false;
          }
        }
      };

      const update = () => {
        const e = pending;
        pending = null;
        const ctm = svg.getScreenCTM();
        if (!e || !ctm) return;
        // Screen → svg user units; goes through the CTM so the cell's tilt is handled.
        const p = new DOMPoint(e.clientX, e.clientY).matrixTransform(ctm.inverse());
        for (const d of dots) {
          const dx = d.x - p.x;
          const dy = d.y - p.y;
          const dist = Math.hypot(dx, dy);
          if (dist >= PUSH_RADIUS) {
            if (d.active) {
              d.el.style.transform = '';
              d.active = false;
            }
            continue;
          }
          // Displacement is 0 at the pointer, peaks about a third of the way out,
          // and fades to 0 at PUSH_RADIUS, so the hovered dot stays put.
          const t = dist / PUSH_RADIUS;
          const push = dist > 0.001 ? PUSH_MAX * 6.75 * t * (1 - t) * (1 - t) : 0;
          const tx = dist > 0.001 ? (dx / dist) * push : 0;
          const ty = dist > 0.001 ? (dy / dist) * push : 0;
          const swell = dist < SWELL_RADIUS ? 1 + SWELL_MAX * (1 - dist / SWELL_RADIUS) ** 2 : 1;
          d.el.style.transform = `translate(${tx.toFixed(2)}px, ${ty.toFixed(2)}px) scale(${swell.toFixed(2)})`;
          d.active = true;
        }
      };

      const host = svg.closest('.trust__cell') ?? svg;
      new IntersectionObserver(([entry]) => {
        visible = entry.isIntersecting;
        if (visible) resume();
        else halt();
      }).observe(host);
      document.addEventListener('visibilitychange', () => (document.hidden ? halt() : resume()));
      host.addEventListener('pointermove', (ev) => {
        const e = ev as PointerEvent;
        if (e.pointerType === 'touch') return;
        hovering = true;
        const idle = pending === null;
        pending = e;
        if (idle) requestAnimationFrame(update);
      });
      host.addEventListener('pointerleave', reset);
    });
  }
</script>
