---
// Decorative: a fanned stack of three contracts. The "text" is blocks, never
// legible, on purpose. Low-detail, 1.5px line, one wood accent (the checked
// boxes + stamp ink). Back to front, so the front contract is whole.
//
// Each contract is drawn differently so the stack reads as three real documents:
// all carry the AC truck mark near the top (the shared #ac-truck vector symbol,
// black on transparent), but the layout differs, and signatures / ink stamps are
// scattered across them rather than repeated on every sheet.
---

<svg class="licensed" viewBox="0 0 250 160" aria-hidden="true" focusable="false">
  <!-- Back: letterhead left, big tick-box, scrawled signature. -->
  <g class="doc doc--back">
    <g transform="translate(10 22) rotate(-8)">
      <path class="line" d="M0 0 H70 L92 22 V120 H0 Z" />
      <path class="line" d="M70 0 V22 H92" />
      <use class="logo" href="#ac-truck" x="10" y="7" width="22" height="21" />
      <rect class="bar" x="38" y="12" width="26" height="5" />
      <rect class="bar soft" x="38" y="21" width="18" height="3.5" />
      <rect class="bar soft" x="12" y="36" width="64" height="3.5" />
      <rect class="bar soft" x="12" y="44" width="50" height="3.5" />
      <rect class="line wood" x="12" y="54" width="30" height="30" />
      <path class="tick" d="M18 69 L25 76 L36 62" />
      <rect class="bar soft" x="50" y="60" width="26" height="3.5" />
      <rect class="bar soft" x="50" y="68" width="18" height="3.5" />
      <path
        class="sign"
        d="M12 100 C16 90 20 90 19 98 C18 104 23 94 27 92 C30 90 28 100 32 98 C36 96 37 91 41 95 C44 98 46 98 52 93"
      />
      <path class="line" d="M12 106 H80" />
    </g>
  </g>

  <!-- Middle: logo set right of a left-hand title block, ink stamp bottom right. -->
  <g class="doc doc--middle">
    <g transform="translate(76 12) rotate(3)">
      <path class="line" d="M0 0 H70 L92 22 V120 H0 Z" />
      <path class="line" d="M70 0 V22 H92" />
      <rect class="bar" x="12" y="12" width="26" height="5" />
      <rect class="bar soft" x="12" y="21" width="20" height="3.5" />
      <use class="logo" href="#ac-truck" x="44" y="6" width="22" height="21" />
      <rect class="bar soft" x="12" y="36" width="58" height="3.5" />
      <rect class="line wood" x="12" y="48" width="34" height="34" />
      <path class="tick" d="M19 65 L27 73 L40 56" />
      <rect class="bar soft" x="54" y="54" width="22" height="3.5" />
      <rect class="bar soft" x="54" y="62" width="16" height="3.5" />
      <rect class="bar soft" x="12" y="90" width="40" height="3.5" />
      <g class="stamp" transform="translate(54 97) rotate(-14)">
        <circle r="17" />
        <circle class="thin" r="13" />
        <rect class="ink" x="-11" y="-5" width="22" height="5" />
        <rect class="ink" x="-7" y="3" width="14" height="3" />
      </g>
      <path class="line" d="M12 106 H80" />
    </g>
  </g>

  <!-- Front: bigger letterhead, two small tick-boxes, signature + rectangular stamp. -->
  <g class="doc doc--front">
    <g transform="translate(140 20) rotate(-1)">
      <path class="line" d="M0 0 H70 L92 22 V120 H0 Z" />
      <path class="line" d="M70 0 V22 H92" />
      <use class="logo" href="#ac-truck" x="10" y="5" width="28" height="26" />
      <rect class="bar" x="44" y="10" width="20" height="5" />
      <rect class="bar soft" x="44" y="19" width="14" height="3.5" />
      <path class="line" d="M12 36 H80" />
      <rect class="line wood" x="12" y="45" width="15" height="15" />
      <path class="tick sm" d="M15 52 L19 56 L25 48" />
      <rect class="bar soft" x="34" y="48" width="40" height="3.5" />
      <rect class="bar soft" x="34" y="55" width="28" height="3.5" />
      <rect class="line wood" x="12" y="66" width="15" height="15" />
      <path class="tick sm" d="M15 73 L19 77 L25 69" />
      <rect class="bar soft" x="34" y="69" width="40" height="3.5" />
      <rect class="bar soft" x="34" y="76" width="22" height="3.5" />
      <g class="stamp" transform="translate(60 94) rotate(8)">
        <rect class="box" x="-19" y="-9" width="38" height="18" />
        <rect class="thin box" x="-16" y="-6" width="32" height="12" />
        <rect class="ink" x="-11" y="-2.5" width="22" height="5" />
      </g>
      <path
        class="sign"
        d="M12 98 C14 90 19 88 18 96 C17 103 24 90 28 91 C31 92 27 101 32 100 C36 99 37 93 43 96"
      />
      <path class="line" d="M12 106 H80" />
    </g>
  </g>
</svg>

<script is:inline>
  // Intro trigger (inline so data-intro lands before first paint, hiding the
  // second and third contract with no flash). Placed when the 10rem image area
  // scrolls into view, once.
  (function () {
    var svg = document.currentScript.previousElementSibling;
    if (!svg || !svg.classList.contains('licensed')) return;
    if (!('IntersectionObserver' in window)) return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    svg.setAttribute('data-intro', '');
    var area = svg.parentElement || svg;
    var io = new IntersectionObserver(
      function (entries) {
        if (!entries.some(function (e) { return e.isIntersecting; })) return;
        svg.classList.add('is-placed');
        io.disconnect();
      },
      { threshold: 0.6 }
    );
    io.observe(area);
  })();
</script>

<style>
  /* The svg keeps its slot (set by the cell) but is drawn larger, overflowing
     it, so the slot itself never grows. Phones: ~15% larger, anchored
     bottom-right so it grows up and left. The cell can retune scale, tilt, origin
     and offset per breakpoint through the --licensed-* variables. */
  .licensed {
    display: block;
    height: 100%;
    width: auto;
    overflow: visible;
    transform: translate(var(--licensed-x, 0), var(--licensed-y, 0)) rotate(var(--licensed-tilt, 0deg))
      scale(var(--licensed-scale, 1.15));
    transform-origin: var(--licensed-origin, right bottom);
  }
  /* Hover: each contract lifts off the stack by a different amount, so they
     fan apart; the one under the cursor lifts a touch more. The lift lives on an
     outer group because the contract's own tilt is an SVG transform attribute,
     which a CSS transform would replace. */
  .licensed {
    pointer-events: auto;
  }
  .doc {
    transform: translateY(calc(var(--lift, 0px) + var(--own, 0px)));
    transition: transform 0.45s cubic-bezier(0.2, 0.7, 0.3, 1);
  }
  /* Intro: only the back (leftmost) contract is there at first. When the image
     area scrolls into view the script adds .is-placed and the middle, then the
     front contract slide up from below the bento cell (whose overflow clips them)
     onto the table. data-intro is set by that script, so without JS, or with
     reduced motion, all three are simply shown. The keyframes have no "to": the
     contract ends at whatever its normal (hover-lift) transform is. */
  @media (prefers-reduced-motion: no-preference) {
    .licensed[data-intro]:not(.is-placed) .doc--middle,
    .licensed[data-intro]:not(.is-placed) .doc--front {
      visibility: hidden;
      transform: translateY(200px);
    }
    .licensed.is-placed .doc--middle {
      animation: doc-in 0.9s cubic-bezier(0.22, 0.8, 0.3, 1) 0.1s backwards;
    }
    .licensed.is-placed .doc--front {
      animation: doc-in 0.9s cubic-bezier(0.22, 0.8, 0.3, 1) 0.7s backwards;
    }
  }
  @keyframes doc-in {
    from {
      transform: translateY(200px);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .licensed:hover .doc--back {
      --lift: -7px;
    }
    .licensed:hover .doc--middle {
      --lift: -4px;
    }
    .licensed:hover .doc--front {
      --lift: -6px;
    }
    .licensed .doc:hover {
      --own: -4px;
    }
  }
  .line {
    fill: var(--color-surface);
    stroke: var(--color-border-strong);
    stroke-width: 1.5;
    stroke-linejoin: miter;
    vector-effect: non-scaling-stroke;
  }
  .wood {
    fill: var(--color-accent);
  }
  .bar {
    fill: var(--color-text);
  }
  .bar.soft {
    fill: var(--color-border);
  }
  .tick {
    fill: none;
    stroke: var(--color-text);
    stroke-width: 4;
    stroke-linecap: square;
    stroke-linejoin: miter;
    vector-effect: non-scaling-stroke;
  }
  .tick.sm {
    stroke-width: 2.5;
  }
  /* Signature: one loose ink scrawl, round-capped so it reads as handwriting
     against the square, ruled everything else. */
  .sign {
    fill: none;
    stroke: var(--color-text);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  /* Ink stamp: wood-deep rings/box with a couple of solid blocks standing in
     for the word, slightly faded and tilted like a real impression. */
  .stamp {
    opacity: 0.85;
  }
  .stamp circle,
  .stamp .box {
    fill: none;
    stroke: var(--color-accent-deep);
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }
  .stamp .thin {
    stroke-width: 1;
  }
  .stamp .ink {
    fill: var(--color-accent-deep);
  }
  /* The mark is black on transparent; flip it where the surface goes dark. */
  .logo {
    fill: var(--color-text);
  }
  :global(.on-dark) .logo {
    filter: invert(1);
  }
</style>
