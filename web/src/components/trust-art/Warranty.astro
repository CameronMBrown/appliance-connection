---
// Decorative: a rounded crest-shield carrying the AC truck mark. The mark is
// the client's own basic truck logo, traced to vector (see truck-path.ts) and drawn
// from the shared #ac-truck symbol, kept small so the shield reads first and the truck second.
---

<svg class="warranty" viewBox="0 0 160 190" aria-hidden="true" focusable="false">
  <defs>
    <clipPath id="warranty-shield-clip">
      <path
        d="M80 6 C99 19 125 25 149 25 V92 C149 139 118 168 80 185 C42 168 11 139 11 92 V25 C35 25 61 19 80 6 Z"
      />
    </clipPath>
    <linearGradient id="warranty-beam" x1="0" x2="1" y1="0" y2="0">
      <stop offset="0" stop-color="#fff" stop-opacity="0" />
      <stop offset="0.5" stop-color="#fff" stop-opacity="0.75" />
      <stop offset="1" stop-color="#fff" stop-opacity="0" />
    </linearGradient>
  </defs>
  <path
    class="shield"
    d="M80 6 C99 19 125 25 149 25 V92 C149 139 118 168 80 185 C42 168 11 139 11 92 V25 C35 25 61 19 80 6 Z"
  />
  <path
    class="inner"
    d="M80 6 C99 19 125 25 149 25 V92 C149 139 118 168 80 185 C42 168 11 139 11 92 V25 C35 25 61 19 80 6 Z"
    transform="translate(80 98) scale(0.86) translate(-80 -98)"
  />
  <use class="truck" href="#ac-truck" x="48.5" y="62.8" width="62.9" height="59.3" />
  <!-- Shimmer: a soft slanted band of light, clipped to the shield, parked off
       its left edge until hover sends it across. -->
  <g clip-path="url(#warranty-shield-clip)">
    <rect class="beam" x="0" y="-10" width="50" height="210" />
  </g>
</svg>

<style>
  .warranty {
    display: block;
    height: 100%;
    width: auto;
    overflow: visible;
  }
  .warranty {
    pointer-events: auto;
  }
  .beam {
    fill: url(#warranty-beam);
    transform: translateX(-90px) skewX(-18deg);
  }
  @media (prefers-reduced-motion: no-preference) {
    .warranty.is-shimmering .beam {
      animation: warranty-sweep 1.1s ease-in-out;
    }
  }
  @keyframes warranty-sweep {
    from {
      transform: translateX(-90px) skewX(-18deg);
    }
    to {
      transform: translateX(230px) skewX(-18deg);
    }
  }
  .truck {
    fill: var(--color-text);
  }
  .shield {
    fill: var(--color-accent);
    stroke: var(--color-border-strong);
    stroke-width: 1.5;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .inner {
    fill: none;
    stroke: var(--color-border-strong);
    stroke-width: 1;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
</style>

<script>
  // Hover starts the shimmer, and it always plays through once: the class is only
  // removed when the sweep ends, not when the pointer leaves (a :hover rule would
  // cut it off). Re-entering mid-sweep doesn't restart it; entering again after it
  // finishes plays it again. The animation itself is gated on reduced motion in CSS.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<SVGSVGElement>('svg.warranty').forEach((svg) => {
      svg.addEventListener('pointerenter', () => svg.classList.add('is-shimmering'));
      svg.addEventListener('animationend', () => svg.classList.remove('is-shimmering'));
    });
  }
</script>
