{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ac/faq",
  "title": "FAQ",
  "category": "ac",
  "icon": "editor-help",
  "description": "Section header + accordion of questions and answers.",
  "textdomain": "ac-blocks",
  "attributes": {
    "eyebrow": {
      "type": "string",
      "default": ""
    },
    "heading": {
      "type": "string",
      "default": ""
    },
    "text": {
      "type": "string",
      "default": ""
    },
    "linkLabel": {
      "type": "string",
      "default": ""
    },
    "linkUrl": {
      "type": "string",
      "default": ""
    },
    "items": {
      "type": "array",
      "default": []
    },
    "footnote": {
      "type": "string",
      "default": ""
    },
    "background": {
      "type": "string",
      "enum": [
        "paper",
        "alt"
      ],
      "default": "alt"
    }
  },
  "supports": {
    "html": false
  },
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}
