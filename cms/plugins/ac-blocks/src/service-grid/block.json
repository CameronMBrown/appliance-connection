{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ac/service-grid",
  "title": "Service grid",
  "category": "ac",
  "icon": "grid-view",
  "description": "Section header + a ruled grid of service cards (InnerBlocks).",
  "textdomain": "ac-blocks",
  "attributes": {
    "eyebrow": {
      "type": "string",
      "default": ""
    },
    "heading": {
      "type": "string",
      "default": ""
    },
    "text": {
      "type": "string",
      "default": ""
    },
    "linkLabel": {
      "type": "string",
      "default": ""
    },
    "linkUrl": {
      "type": "string",
      "default": ""
    },
    "numbered": {
      "type": "boolean",
      "default": true
    },
    "background": {
      "type": "string",
      "enum": [
        "paper",
        "alt"
      ],
      "default": "alt"
    }
  },
  "supports": {
    "html": false
  },
  "allowedBlocks": [
    "ac/service-card"
  ],
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}
