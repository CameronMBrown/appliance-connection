{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ac/hero",
  "title": "Hero",
  "category": "ac",
  "icon": "cover-image",
  "description": "Page-top video hero: arched wordmark (or a plain headline), Benguiat sub-line, up to two buttons, optional phone strip.",
  "textdomain": "ac-blocks",
  "attributes": {
    "heading": {
      "type": "string",
      "default": ""
    },
    "subheading": {
      "type": "string",
      "default": ""
    },
    "videoId": {
      "type": "number"
    },
    "videoUrl": {
      "type": "string",
      "default": ""
    },
    "posterUrl": {
      "type": "string",
      "default": ""
    },
    "imageId": {
      "type": "number"
    },
    "imageUrl": {
      "type": "string",
      "default": ""
    },
    "primaryLabel": {
      "type": "string",
      "default": "Our services"
    },
    "primaryShortLabel": {
      "type": "string",
      "default": ""
    },
    "primaryUrl": {
      "type": "string",
      "default": ""
    },
    "secondaryLabel": {
      "type": "string",
      "default": ""
    },
    "secondaryShortLabel": {
      "type": "string",
      "default": ""
    },
    "secondaryUrl": {
      "type": "string",
      "default": ""
    },
    "scrim": {
      "type": "string",
      "enum": [
        "standard",
        "strong"
      ],
      "default": "standard"
    },
    "showPhones": {
      "type": "boolean",
      "default": true
    }
  },
  "supports": {
    "html": false,
    "multiple": false
  },
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}
