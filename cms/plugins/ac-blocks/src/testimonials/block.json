{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ac/testimonials",
  "title": "Testimonials",
  "category": "ac",
  "icon": "format-quote",
  "description": "One homeowner quote at a time, letters flipping in on a fixed-height stage and rotating every 30s. Quotes come from the Testimonials post type; auto-matches the page's tags or pin specific ones.",
  "textdomain": "ac-blocks",
  "attributes": {
    "divider": {
      "type": "boolean",
      "default": true
    },
    "heading": {
      "type": "string",
      "default": ""
    },
    "mode": {
      "type": "string",
      "enum": [
        "all",
        "region",
        "service",
        "manual",
        "auto"
      ],
      "default": "all"
    },
    "limit": {
      "type": "number",
      "default": 20
    },
    "pinned": {
      "type": "array",
      "default": []
    },
    "filterRegion": {
      "type": "string",
      "default": ""
    },
    "filterAppliance": {
      "type": "string",
      "default": ""
    },
    "isDark": {
      "type": "boolean",
      "default": false
    }
  },
  "supports": {
    "html": false
  },
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}
