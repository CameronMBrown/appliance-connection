{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ac/cta-band",
  "title": "CTA band",
  "category": "ac",
  "icon": "megaphone",
  "description": "Boxed closing pitch with the wood corner tick; dark by default, optional region phone button.",
  "textdomain": "ac-blocks",
  "attributes": {
    "heading": {
      "type": "string",
      "default": ""
    },
    "text": {
      "type": "string",
      "default": ""
    },
    "ctaLabel": {
      "type": "string",
      "default": "Contact Us"
    },
    "ctaUrl": {
      "type": "string",
      "default": "/contact/"
    },
    "isDark": {
      "type": "boolean",
      "default": true
    },
    "showPhone": {
      "type": "boolean",
      "default": false
    }
  },
  "supports": {
    "html": false
  },
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}
